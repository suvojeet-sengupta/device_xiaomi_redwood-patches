+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.applications.applock;
+
+import android.content.Context;
+
+import com.android.settings.core.BasePreferenceController;
+
+/** Shows the App lock entry when the build has Android's App Lock turned on. */
+public class AppLockPreferenceController extends BasePreferenceController {
+
+    public AppLockPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    static boolean isAppLockEnabled() {
+        return android.security.Flags.appLockApis() && android.security.Flags.appLockCore();
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return isAppLockEnabled() ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+}
diff --git a/src/com/android/settings/applications/applock/AppLockSettingsActivity.java b/src/com/android/settings/applications/applock/AppLockSettingsActivity.java
new file mode 100644
index 0000000..4543e6e
--- /dev/null
+++ b/src/com/android/settings/applications/applock/AppLockSettingsActivity.java
@@ -0,0 +1,31 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.applications.applock;
+
+import android.os.Bundle;
+
+import androidx.annotation.Nullable;
+
+import com.android.settings.R;
+import com.android.settingslib.collapsingtoolbar.CollapsingToolbarBaseActivity;
+
+/** Hosts the list of apps that App Lock can lock. */
+public class AppLockSettingsActivity extends CollapsingToolbarBaseActivity {
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        if (!AppLockPreferenceController.isAppLockEnabled()) {
+            finish();
+            return;
+        }
+        if (savedInstanceState == null) {
+            getSupportFragmentManager()
+                    .beginTransaction()
+                    .replace(R.id.content_frame, new AppLockSettingsFragment())
+                    .commit();
+        }
+    }
+}
diff --git a/src/com/android/settings/applications/applock/AppLockSettingsFragment.java b/src/com/android/settings/applications/applock/AppLockSettingsFragment.java
new file mode 100644
index 0000000..0aff20f
--- /dev/null
+++ b/src/com/android/settings/applications/applock/AppLockSettingsFragment.java
@@ -0,0 +1,159 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.applications.applock;
+
+import android.app.KeyguardManager;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.hardware.biometrics.BiometricPrompt;
+import android.os.Bundle;
+import android.os.CancellationSignal;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.util.Log;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceFragmentCompat;
+import androidx.preference.PreferenceScreen;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.Utils;
+
+import java.text.Collator;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+/**
+ * Lists the launchable apps that support App Lock, each with a switch. Turning a switch either way
+ * asks for the fingerprint or screen lock first; locking itself is Android's App Lock.
+ */
+public class AppLockSettingsFragment extends PreferenceFragmentCompat {
+
+    private static final String TAG = "AppLockSettings";
+
+    private PackageManager mPm;
+    private CancellationSignal mCancel;
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        final Context context = requireContext();
+        mPm = context.getPackageManager();
+        final PreferenceScreen screen = getPreferenceManager().createPreferenceScreen(context);
+        setPreferenceScreen(screen);
+        requireActivity().setTitle(R.string.app_lock_title);
+
+        final boolean secure = context.getSystemService(KeyguardManager.class).isDeviceSecure();
+        if (!secure) {
+            final Preference note = new Preference(context);
+            note.setTitle(R.string.app_lock_no_screen_lock);
+            note.setSelectable(false);
+            screen.addPreference(note);
+        }
+
+        for (ApplicationInfo app : getLockableApps()) {
+            final SwitchPreferenceCompat pref = new SwitchPreferenceCompat(context);
+            pref.setKey(app.packageName);
+            pref.setTitle(app.loadLabel(mPm));
+            pref.setIcon(app.loadIcon(mPm));
+            pref.setChecked(isLocked(app.packageName));
+            pref.setEnabled(secure);
+            pref.setPersistent(false);
+            pref.setOnPreferenceChangeListener((p, value) -> {
+                confirmThenSet((SwitchPreferenceCompat) p, (Boolean) value);
+                // The switch moves once the user is confirmed
+                return false;
+            });
+            screen.addPreference(pref);
+        }
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        // A locked app may have been unlocked from elsewhere
+        final PreferenceScreen screen = getPreferenceScreen();
+        for (int i = 0; i < screen.getPreferenceCount(); i++) {
+            final Preference p = screen.getPreference(i);
+            if (p instanceof SwitchPreferenceCompat) {
+                ((SwitchPreferenceCompat) p).setChecked(isLocked(p.getKey()));
+            }
+        }
+    }
+
+    @Override
+    public void onPause() {
+        if (mCancel != null) {
+            mCancel.cancel();
+            mCancel = null;
+        }
+        super.onPause();
+    }
+
+    private List<ApplicationInfo> getLockableApps() {
+        final Intent launcher = new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_LAUNCHER);
+        final String self = requireContext().getPackageName();
+        final Set<String> seen = new HashSet<>();
+        final List<ApplicationInfo> apps = new ArrayList<>();
+        for (ResolveInfo ri : mPm.queryIntentActivities(launcher, 0)) {
+            final ApplicationInfo app = ri.activityInfo.applicationInfo;
+            if (self.equals(app.packageName) || !seen.add(app.packageName)) continue;
+            if (!app.isAppLockSupported) continue;
+            apps.add(app);
+        }
+        final Collator collator = Collator.getInstance();
+        apps.sort((a, b) -> collator.compare(
+                a.loadLabel(mPm).toString(), b.loadLabel(mPm).toString()));
+        return apps;
+    }
+
+    private boolean isLocked(String packageName) {
+        try {
+            return mPm.isPackageAppLockEnabled(packageName);
+        } catch (SecurityException | IllegalArgumentException e) {
+            Log.w(TAG, "Couldn't read the App Lock state of " + packageName, e);
+            return false;
+        }
+    }
+
+    private void confirmThenSet(SwitchPreferenceCompat pref, boolean lock) {
+        final Context context = requireContext();
+        final int userId = UserHandle.myUserId();
+        final BiometricPrompt prompt = new BiometricPrompt.Builder(context)
+                .setTitle(context.getString(lock ? R.string.app_lock_confirm_lock
+                        : R.string.app_lock_confirm_unlock, pref.getTitle()))
+                .setDeviceCredentialAllowed(true)
+                .setTextForDeviceCredential(null,
+                        Utils.getConfirmCredentialStringForUser(
+                                context, userId, Utils.getCredentialType(context, userId)),
+                        null)
+                .build();
+        final Handler handler = new Handler(Looper.getMainLooper());
+        mCancel = new CancellationSignal();
+        prompt.authenticate(mCancel, handler::post, new BiometricPrompt.AuthenticationCallback() {
+            @Override
+            public void onAuthenticationSucceeded(BiometricPrompt.AuthenticationResult result) {
+                mCancel = null;
+                try {
+                    mPm.setPackageAppLockEnabled(pref.getKey(), lock);
+                } catch (SecurityException | IllegalArgumentException e) {
+                    Log.e(TAG, "Couldn't change the App Lock state of " + pref.getKey(), e);
+                }
+                pref.setChecked(isLocked(pref.getKey()));
+            }
+
+            @Override
+            public void onAuthenticationError(int errorCode, CharSequence errString) {
+                mCancel = null;
+            }
+        });
+    }
+}
-- 
