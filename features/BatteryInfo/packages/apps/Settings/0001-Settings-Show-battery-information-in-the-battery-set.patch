+<!--
+     SPDX-License-Identifier: Apache-2.0
+-->
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <!-- Battery: battery information -->
+    <string name="battery_info_title">Battery information</string>
+    <string name="battery_info_health_title">Battery health</string>
+    <string name="battery_info_cycle_count_title">Charge cycles</string>
+    <string name="battery_info_full_capacity_title">Full charge capacity</string>
+    <string name="battery_info_design_capacity_title">Design capacity</string>
+    <string name="battery_info_temperature_title">Temperature</string>
+    <string name="battery_info_voltage_title">Voltage</string>
+    <string name="battery_info_percent"><xliff:g id="percent">%1$d</xliff:g>%%</string>
+    <string name="battery_info_mah"><xliff:g id="mah">%1$d</xliff:g> mAh</string>
+    <string name="battery_info_celsius"><xliff:g id="degrees">%1$.1f</xliff:g> °C</string>
+    <string name="battery_info_volts"><xliff:g id="volts">%1$.2f</xliff:g> V</string>
+</resources>
