diff --git a/src/com/android/settings/fuelgauge/BatteryInfoPreferenceController.java b/src/com/android/settings/fuelgauge/BatteryInfoPreferenceController.java
new file mode 100644
index 0000000..4064c11
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/BatteryInfoPreferenceController.java
@@ -0,0 +1,92 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.fuelgauge;
+
+import android.content.Context;
+
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+import java.io.BufferedReader;
+import java.io.FileReader;
+import java.io.IOException;
+
+/** One line of battery information, read from the battery's power supply node. */
+public class BatteryInfoPreferenceController extends BasePreferenceController {
+
+    private static final String BATTERY =
+            "/sys/devices/platform/soc/soc:qcom,pmic_glink/soc:qcom,pmic_glink:qcom,battery_charger"
+            + "/power_supply/battery/";
+
+    private static final String KEY_HEALTH = "battery_info_health";
+    private static final String KEY_CYCLE_COUNT = "battery_info_cycle_count";
+    private static final String KEY_FULL_CAPACITY = "battery_info_full_capacity";
+    private static final String KEY_DESIGN_CAPACITY = "battery_info_design_capacity";
+    private static final String KEY_TEMPERATURE = "battery_info_temperature";
+    private static final String KEY_VOLTAGE = "battery_info_voltage";
+
+    public BatteryInfoPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return getSummary() != null ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        preference.setSummary(getSummary());
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        switch (getPreferenceKey()) {
+            case KEY_HEALTH: {
+                final long full = read("charge_full");
+                final long design = read("charge_full_design");
+                if (full <= 0 || design <= 0) return null;
+                return mContext.getString(R.string.battery_info_percent,
+                        Math.round(full * 100.0 / design));
+            }
+            case KEY_CYCLE_COUNT: {
+                final long cycles = read("cycle_count");
+                return cycles < 0 ? null : String.valueOf(cycles);
+            }
+            case KEY_FULL_CAPACITY:
+                return mah(read("charge_full"));
+            case KEY_DESIGN_CAPACITY:
+                return mah(read("charge_full_design"));
+            case KEY_TEMPERATURE: {
+                final long temp = read("temp");
+                return temp == Long.MIN_VALUE ? null
+                        : mContext.getString(R.string.battery_info_celsius, temp / 10.0);
+            }
+            case KEY_VOLTAGE: {
+                final long uv = read("voltage_now");
+                return uv <= 0 ? null
+                        : mContext.getString(R.string.battery_info_volts, uv / 1000000.0);
+            }
+            default:
+                return null;
+        }
+    }
+
+    private CharSequence mah(long uah) {
+        return uah <= 0 ? null : mContext.getString(R.string.battery_info_mah, uah / 1000);
+    }
+
+    /** The node's value, or Long.MIN_VALUE when it can't be read. */
+    private static long read(String node) {
+        try (BufferedReader reader = new BufferedReader(new FileReader(BATTERY + node))) {
+            return Long.parseLong(reader.readLine().trim());
+        } catch (IOException | NumberFormatException | NullPointerException e) {
+            return Long.MIN_VALUE;
+        }
+    }
+}
