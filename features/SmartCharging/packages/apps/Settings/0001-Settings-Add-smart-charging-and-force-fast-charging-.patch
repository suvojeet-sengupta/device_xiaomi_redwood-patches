+
     <com.android.settingslib.widget.FooterPreference
         android:key="power_usage_footer"
         android:title="@string/battery_footer_summary"
diff --git a/src/com/android/settings/fuelgauge/ChargingModePreferenceController.java b/src/com/android/settings/fuelgauge/ChargingModePreferenceController.java
new file mode 100644
index 0000000..4987cd2
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/ChargingModePreferenceController.java
@@ -0,0 +1,76 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.fuelgauge;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+import androidx.preference.TwoStatePreference;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/**
+ * A charging mode the device sets from a persist.sys property. Smart charging and force fast
+ * charging pull against each other, so turning one on turns the other off.
+ */
+public abstract class ChargingModePreferenceController extends TogglePreferenceController {
+
+    static final String KEY_SMART_CHARGING = "smart_charging";
+    static final String KEY_FORCE_FAST_CHARGE = "force_fast_charge";
+
+    static final String PROP_SMART_CHARGING = "persist.sys.smart_charging";
+    static final String PROP_FORCE_FAST_CHARGE = "persist.sys.force_fast_charge";
+
+    private final String mProperty;
+    private final String mOtherKey;
+    private final String mOtherProperty;
+    private PreferenceScreen mScreen;
+
+    ChargingModePreferenceController(Context context, String key, String property,
+            String otherKey, String otherProperty) {
+        super(context, key);
+        mProperty = property;
+        mOtherKey = otherKey;
+        mOtherProperty = otherProperty;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mScreen = screen;
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        // The device tree sets a default for the property when it has the mode
+        return SystemProperties.get(mProperty).isEmpty() ? UNSUPPORTED_ON_DEVICE : AVAILABLE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return SystemProperties.getBoolean(mProperty, false);
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        if (isChecked && SystemProperties.getBoolean(mOtherProperty, false)) {
+            SystemProperties.set(mOtherProperty, "0");
+            final Preference other = mScreen != null ? mScreen.findPreference(mOtherKey) : null;
+            if (other instanceof TwoStatePreference) {
+                ((TwoStatePreference) other).setChecked(false);
+            }
+        }
+        SystemProperties.set(mProperty, isChecked ? "1" : "0");
+        return true;
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_battery;
+    }
+}
diff --git a/src/com/android/settings/fuelgauge/ForceFastChargePreferenceController.java b/src/com/android/settings/fuelgauge/ForceFastChargePreferenceController.java
new file mode 100644
index 0000000..97a9a16
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/ForceFastChargePreferenceController.java
@@ -0,0 +1,15 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.fuelgauge;
+
+import android.content.Context;
+
+/** Force fast charging: the charger firmware drops the thermal current limits. */
+public class ForceFastChargePreferenceController extends ChargingModePreferenceController {
+
+    public ForceFastChargePreferenceController(Context context, String key) {
+        super(context, key, PROP_FORCE_FAST_CHARGE, KEY_SMART_CHARGING, PROP_SMART_CHARGING);
+    }
+}
diff --git a/src/com/android/settings/fuelgauge/SmartChargingPreferenceController.java b/src/com/android/settings/fuelgauge/SmartChargingPreferenceController.java
new file mode 100644
index 0000000..075191b
--- /dev/null
+++ b/src/com/android/settings/fuelgauge/SmartChargingPreferenceController.java
@@ -0,0 +1,15 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.fuelgauge;
+
+import android.content.Context;
+
+/** Smart charging: the charger firmware stops at 80% to keep the battery healthy. */
+public class SmartChargingPreferenceController extends ChargingModePreferenceController {
+
+    public SmartChargingPreferenceController(Context context, String key) {
+        super(context, key, PROP_SMART_CHARGING, KEY_FORCE_FAST_CHARGE, PROP_FORCE_FAST_CHARGE);
+    }
+}
