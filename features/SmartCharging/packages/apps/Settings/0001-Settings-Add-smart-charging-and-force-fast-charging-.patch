     <string name="low_power_standby_summary">While the phone is idle, stop background apps from holding it awake or using the network. Messages pushed through Google Play services still arrive.</string>
+
+    <!-- Battery: charging modes -->
+    <string name="smart_charging_title">Smart charging</string>
+    <string name="smart_charging_summary">Stop charging at 80% to slow down battery wear. Turns off force fast charging.</string>
+    <string name="force_fast_charge_title">Force fast charging</string>
+    <string name="force_fast_charge_summary">Charge at full speed even while the phone is warm or in use. The phone gets hotter while charging. Turns off smart charging.</string>
 </resources>
