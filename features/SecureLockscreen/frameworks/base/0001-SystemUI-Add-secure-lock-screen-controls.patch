--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/util/LockscreenSecureControls.java
@@ -0,0 +1,45 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.systemui.util;
+
+import android.app.ActivityManager;
+import android.app.KeyguardManager;
+import android.content.Context;
+import android.os.UserHandle;
+import android.provider.Settings;
+
+import java.util.Set;
+
+/**
+ * Secure lock screen controls: while the device is locked with a PIN, pattern or password, keep
+ * the power menu closed and have the network, Bluetooth, airplane mode and location tiles ask for
+ * an unlock first, so a locked phone can't be cut off or switched off.
+ */
+public final class LockscreenSecureControls {
+
+    /** Settings.Secure key, 1 turns the secure controls on. */
+    public static final String SETTING = "lockscreen_secure_controls";
+
+    private static final Set<String> TILES = Set.of(
+            "internet", "wifi", "cell", "bt", "airplane", "hotspot", "location", "nfc");
+
+    private LockscreenSecureControls() {}
+
+    /** Whether the secure controls are on and the device is locked behind a credential. */
+    public static boolean isLocked(Context context) {
+        if (Settings.Secure.getIntForUser(context.getContentResolver(), SETTING, 0,
+                UserHandle.USER_CURRENT) != 1) {
+            return false;
+        }
+        final KeyguardManager km = context.getSystemService(KeyguardManager.class);
+        return km != null && km.isKeyguardLocked()
+                && km.isDeviceSecure(ActivityManager.getCurrentUser());
+    }
+
+    /** Whether a click on the tile with this spec has to wait for an unlock. */
+    public static boolean tileNeedsUnlock(Context context, String spec) {
+        return spec != null && TILES.contains(spec) && isLocked(context);
+    }
+}
