From 91cc55d33a76d7de31dec5e125aa209b83fcd47c Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Sat, 28 Nov 2026 08:34:00 +0000
Subject: [PATCH] Settings: Add a switch to turn off the shade blur

Add Disable blur to the appearance section of the display settings. It
sets Settings.Secure sysui_shade_blur_disabled, which makes SystemUI
drop the blur behind the notification panel and quick settings.

Change-Id: I8e3a1f6c2b9d4075a1c3e5f7b9d1a3c5e7f9b1d3
---
 res/values/shade_blur_strings.xml | 9 +++++++++
 res/xml/display_settings.xml      | 6 ++++++
 2 files changed, 15 insertions(+)
 create mode 100644 res/values/shade_blur_strings.xml

diff --git a/res/values/shade_blur_strings.xml b/res/values/shade_blur_strings.xml
new file mode 100644
index 0000000..faf4bf7
--- /dev/null
+++ b/res/values/shade_blur_strings.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-License-Identifier: Apache-2.0
+-->
+<resources>
+    <!-- Display: notification shade and quick settings blur -->
+    <string name="shade_blur_disabled_title">Disable blur</string>
+    <string name="shade_blur_disabled_summary">Turn off the blur behind the notification panel and quick settings</string>
+</resources>
diff --git a/res/xml/display_settings.xml b/res/xml/display_settings.xml
index 5951be1..e640fcf 100644
--- a/res/xml/display_settings.xml
+++ b/res/xml/display_settings.xml
@@ -115,6 +115,12 @@
             android:fragment="com.android.settings.gestures.SystemNavigationGestureSettings"
             settings:controller="com.android.settings.gestures.SystemNavigationPreferenceController"/>
 
+        <com.android.settings.custom.preference.SecureSettingSwitchPreference
+            android:key="sysui_shade_blur_disabled"
+            android:title="@string/shade_blur_disabled_title"
+            android:summary="@string/shade_blur_disabled_summary"
+            android:defaultValue="false"/>
+
     </PreferenceCategory>
 
     <PreferenceCategory
-- 
2.43.0

