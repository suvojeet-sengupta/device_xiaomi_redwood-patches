From 5bc481700f3d6ec3398f35c9ff43f36b0d853a8c Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Sat, 28 Nov 2026 08:34:00 +0000
Subject: [PATCH] Settings: Add switches to turn off blur

Add two switches to the appearance section of the display settings.
Disable all blur sets Settings.Global disable_window_blurs, the same
setting as Allow window-level blurs in the developer options, which
turns off window blur everywhere: the notification panel, quick
settings, lock screen, recents and app dialogs. Disable panel blur sets
Settings.Secure sysui_shade_blur_disabled, which only drops the blur
behind the notification panel and quick settings. It is greyed out
while all blur is off.

Change-Id: I8e3a1f6c2b9d4075a1c3e5f7b9d1a3c5e7f9b1d3
---
 res/values/shade_blur_strings.xml | 11 +++++++++++
 res/xml/display_settings.xml      | 14 ++++++++++++++
 2 files changed, 25 insertions(+)
 create mode 100644 res/values/shade_blur_strings.xml

diff --git a/res/values/shade_blur_strings.xml b/res/values/shade_blur_strings.xml
new file mode 100644
index 0000000..6f34f42
--- /dev/null
+++ b/res/values/shade_blur_strings.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-License-Identifier: Apache-2.0
+-->
+<resources>
+    <!-- Display: blur -->
+    <string name="all_blur_disabled_title">Disable all blur</string>
+    <string name="all_blur_disabled_summary">Turn off blur everywhere: notification panel, quick settings, lock screen, recents and app dialogs</string>
+    <string name="shade_blur_disabled_title">Disable panel blur</string>
+    <string name="shade_blur_disabled_summary">Turn off only the blur behind the notification panel and quick settings</string>
+</resources>
diff --git a/res/xml/display_settings.xml b/res/xml/display_settings.xml
index 5951be1..540ad00 100644
--- a/res/xml/display_settings.xml
+++ b/res/xml/display_settings.xml
@@ -115,6 +115,20 @@
             android:fragment="com.android.settings.gestures.SystemNavigationGestureSettings"
             settings:controller="com.android.settings.gestures.SystemNavigationPreferenceController"/>
 
+        <com.android.settings.custom.preference.GlobalSettingSwitchPreference
+            android:key="disable_window_blurs"
+            android:title="@string/all_blur_disabled_title"
+            android:summary="@string/all_blur_disabled_summary"
+            android:disableDependentsState="true"
+            android:defaultValue="false"/>
+
+        <com.android.settings.custom.preference.SecureSettingSwitchPreference
+            android:key="sysui_shade_blur_disabled"
+            android:dependency="disable_window_blurs"
+            android:title="@string/shade_blur_disabled_title"
+            android:summary="@string/shade_blur_disabled_summary"
+            android:defaultValue="false"/>
+
     </PreferenceCategory>
 
     <PreferenceCategory
-- 
