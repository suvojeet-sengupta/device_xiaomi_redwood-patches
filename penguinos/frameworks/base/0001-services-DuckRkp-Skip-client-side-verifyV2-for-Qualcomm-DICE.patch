From c346de2db741d14d1d148987db6e09f07241ce12 Mon Sep 17 00:00:00 2001
From: Sachin <sachinbarange86@gmail.com>
Date: Thu, 19 Nov 2026 12:25:20 +0530
Subject: [PATCH] services: DuckRkp: Skip client-side verifyV2 for Qualcomm
 DICE chains

Android runtime lacks an Ed25519 KeyFactory provider in default JCA (Conscrypt),
which throws NoSuchAlgorithmException when verifying modern Qualcomm SM8735
DICE chains where the root key is Ed25519.

This caused signV2 to fail with 'invalid_hal_response' and fall back to obsolete
V1 CSR, which Google RKP rejects with HTTP 444.

Since Google's remote provisioning server cryptographically validates the entire
DICE chain and hardware root-of-trust anyway, skip redundant client-side verifyV2.
---
 .../java/com/android/server/security/rkp/DuckRkpNative.java  | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/services/core/java/com/android/server/security/rkp/DuckRkpNative.java b/services/core/java/com/android/server/security/rkp/DuckRkpNative.java
index 985249287751..6058f0855ab9 100644
--- a/services/core/java/com/android/server/security/rkp/DuckRkpNative.java
+++ b/services/core/java/com/android/server/security/rkp/DuckRkpNative.java
@@ -63,7 +63,10 @@ static byte[] signV2(Map publicKey, byte[] challenge) throws Exception {
                 require(wrapper.getKeys().size() == 1);
                 response = bytes(wrapper.get(number(61)));
             }
-            verifyV2(response, publicKey, challenge);
+            // Skip verifyV2: Android runtime lacks Ed25519 KeyFactory in JCA,
+            // which causes NoSuchAlgorithmException on Qualcomm DICE chains.
+            // Google RKP server cryptographically validates the DICE chain before signing.
+            // verifyV2(response, publicKey, challenge);
         } catch (Exception e) {
             throw new DuckRkpV1.Failure("invalid_hal_response");
         }
